# Copie este arquivo para ".env" para rodar localmente (NUNCA suba o .env real pro GitHub).
# No Render, essas mesmas variáveis vão em Settings → Environment, não em arquivo.

SUPABASE_URL=https://uyprazfzkzxnmvpzrogs.supabase.co
SUPABASE_SERVICE_KEY=coloque_aqui_a_chave_service_role_ou_sb_secret

# Obrigatória — só aceita "qr" ou "pairing". Define qual dos dois serviços
# do Render esse processo representa. Sem essa variável configurada
# corretamente, o bot.js recusa subir de propósito (evita os dois serviços
# brigarem pelo mesmo usuário).
MODO_CONEXAO=pairing

# Usada pra disparar notificações push (via edge function send-push) quando
# o bot reconecta, envia a primeira mensagem com sucesso, ou falha por falta
# de permissão num grupo. Sem ela, o bot funciona normalmente — só pula o
# envio de notificação e loga um aviso.
INTERNAL_TRIGGER_SECRET=coloque_aqui_o_mesmo_secret_usado_nas_edge_functions
